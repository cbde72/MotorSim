# Store text files with LF line endings in the repository.
* text=auto eol=lf

# Python / project text formats
*.py text eol=lf
*.pyi text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Windows command files should remain CRLF when added later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.mp4 binary
*.zip binary
